# syntax=docker/dockerfile:1
# Use Ubuntu as base image with desktop environment support
FROM ubuntu:22.04

# Avoid prompts from apt
ENV DEBIAN_FRONTEND=noninteractive

# Set display for VNC
ENV DISPLAY=:1

# Set API base URL (will be overridden by docker-compose)
ENV API_BASE_URL=http://backend:8000

# Install required packages
RUN apt-get update && apt-get install -y \
    wget \
    gnupg \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libwayland-client0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    xdg-utils \
    tigervnc-standalone-server \
    tigervnc-common \
    dbus-x11 \
    x11-xserver-utils \
    xfonts-base \
    xfonts-75dpi \
    xfonts-100dpi \
    openbox \
    curl \
    git \
    python3 \
    python3-pip \
    python3-numpy \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Install noVNC for web-based VNC access
RUN git clone https://github.com/novnc/noVNC.git /opt/noVNC \
    && git clone https://github.com/novnc/websockify /opt/noVNC/utils/websockify \
    && ln -s /opt/noVNC/vnc.html /opt/noVNC/index.html

# Install Google Chrome
RUN wget -q -O - https://dl-ssl.google.com/linux/linux_signing_key.pub | apt-key add - \
    && echo "deb [arch=amd64] http://dl.google.com/linux/chrome/deb/ stable main" >> /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update \
    && apt-get install -y google-chrome-stable \
    && rm -rf /var/lib/apt/lists/*

# Create directory for Chrome extension
RUN mkdir -p /home/chrome/extension

# Copy the unpacked extension from build context
COPY ./extension_dist /home/chrome/extension

# Create VNC password directory
RUN mkdir -p /root/.vnc

# Set VNC password (default: 'phishing123' for security)
RUN bash -lc 'echo "phishing123" | vncpasswd -f > /root/.vnc/passwd && chmod 600 /root/.vnc/passwd'

# Copy startup script and normalize line endings
COPY ./start.sh /start.sh
RUN sed -i 's/\r$//' /start.sh && chmod +x /start.sh

# Expose ports
EXPOSE 5901 6080 9222

# Set working directory
WORKDIR /home/chrome

# Start the services
CMD ["/start.sh"]