# Use Ubuntu as base image with desktop environment support
FROM ubuntu:22.04

# Avoid prompts from apt
ENV DEBIAN_FRONTEND=noninteractive

# Set display for VNC
ENV DISPLAY=:1

# Set API base URL (will be overridden by docker-compose)
ENV API_BASE_URL=http://backend:8000

# Install required packages
RUN apt-get update && apt-get install -y \
    wget \
    gnupg \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libwayland-client0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    xdg-utils \
    tigervnc-standalone-server \
    tigervnc-common \
    dbus-x11 \
    x11-xserver-utils \
    xfonts-base \
    xfonts-75dpi \
    xfonts-100dpi \
    openbox \
    curl \
    git \
    python3 \
    python3-pip \
    python3-numpy \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Install noVNC for web-based VNC access
RUN git clone https://github.com/novnc/noVNC.git /opt/noVNC \
    && git clone https://github.com/novnc/websockify /opt/noVNC/utils/websockify \
    && ln -s /opt/noVNC/vnc.html /opt/noVNC/index.html

# Install Google Chrome
RUN wget -q -O - https://dl-ssl.google.com/linux/linux_signing_key.pub | apt-key add - \
    && echo "deb [arch=amd64] http://dl.google.com/linux/chrome/deb/ stable main" >> /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update \
    && apt-get install -y google-chrome-stable \
    && rm -rf /var/lib/apt/lists/*

# Create directory for Chrome extension
RUN mkdir -p /home/chrome/extension

# Copy the unpacked extension from build context
COPY ./extension_dist /home/chrome/extension

# Create VNC password directory
RUN mkdir -p /root/.vnc

# Set VNC password (default: 'phishing123' for security)
RUN echo "phishing123" | vncpasswd -f > /root/.vnc/passwd \
    && chmod 600 /root/.vnc/passwd

# Create startup script that copies extension to a secure path with safe permissions
RUN printf '#!/bin/bash\n\
# Update config.js with backend URL from environment (skip if read-only mount)\n\
if [ -n "$API_BASE_URL" ] && [ -w /home/chrome/extension/config.js ]; then\n\
  sed -i "s|http://backend:8000|$API_BASE_URL|g" /home/chrome/extension/config.js || true\n\
  sed -i "s|http://localhost:8000|$API_BASE_URL|g" /home/chrome/extension/config.js || true\n\
fi\n\
\
# Prepare a secure copy of the extension (Chrome may refuse world-writable mounts)\n\
rm -rf /opt/extension && mkdir -p /opt/extension\n\
cp -r /home/chrome/extension/. /opt/extension/ || true\n\
find /opt/extension -type d -exec chmod 755 {} \; || true\n\
find /opt/extension -type f -exec chmod 644 {} \; || true\n\
\
# Start VNC server\n\
vncserver :1 -geometry 1920x1080 -depth 24 -SecurityTypes None &\n\
sleep 3\n\
\
# Start noVNC web server\n\
/opt/noVNC/utils/novnc_proxy --vnc localhost:5901 --listen 6080 &\n\
sleep 2\n\
\
# Start Openbox window manager\n\
DISPLAY=:1 openbox &\n\
sleep 2\n\
\
# Create Chrome profile directory and enable Developer Mode\n\
mkdir -p /home/chrome/.config/google-chrome/Default\n\
echo '\''{"extensions":{"ui":{"developer_mode":true}}}'\'' > /home/chrome/.config/google-chrome/Default/Preferences\n\
\
# Launch Chrome FIRST TIME to initialize profile (without extension)\n\
echo "Initializing Chrome profile..."\n\
DISPLAY=:1 timeout 15 google-chrome \\\n  --no-sandbox \\\n  --disable-dev-shm-usage \\\n  --disable-gpu \\\n  --start-maximized \\\n  --no-first-run \\\n  --no-default-browser-check \\\n  --user-data-dir=/home/chrome/.config/google-chrome \\\n  about:blank || true\n\
\
# Wait for Chrome processes to fully stop\n\
echo "Waiting for Chrome to fully initialize..."\n\
sleep 3\n\
pkill -9 chrome || true\n\
sleep 2\n\
# Clear Chrome profile locks if any persisted\n\
rm -f /home/chrome/.config/google-chrome/Singleton* || true\n\
rm -f /home/chrome/.config/google-chrome/Default/LOCK || true\n\
\
# Launch Chrome with extension and persistent profile\n\
echo "Starting Chrome with extension..."\n\
DISPLAY=:1 google-chrome \\\n  --no-sandbox \\\n  --disable-dev-shm-usage \\\n  --disable-gpu \\\n  --start-maximized \\\n  --no-first-run \\\n  --no-default-browser-check \\\n  --user-data-dir=/home/chrome/.config/google-chrome \\\n  --remote-debugging-port=9222 \\\n  --load-extension=/opt/extension \\\n  --enable-logging=stderr \\\n  --v=1 \\\n  chrome://extensions/ https://www.facebook.com &\n\
\
# Keep container running\n\
tail -f /dev/null\n' > /start.sh && chmod +x /start.sh

# Expose ports
EXPOSE 5901 6080 9222

# Set working directory
WORKDIR /home/chrome

# Start the services
CMD ["/start.sh"]
